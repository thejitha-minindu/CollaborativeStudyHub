# ---------------------------------------------------------------
# Runtime state generated by the Study Hub servers & clients.
# (The repo intentionally keeps the compiled out/ classes, certs/
# keystore and the seeded shared_storage/ samples under version
# control so the project runs with zero setup.)
# ---------------------------------------------------------------

# Disk persistence engine (recreated & seeded on first server start)
data/
*.db.tmp
history_*.log

# Per-user download folders created by the Swing client
downloads/
downloads_test/

# Build scratch file emitted by build.bat / build.sh
sources.txt
