# ===============================================================
# Compiled Java Class Files & Build Artifacts
# ===============================================================
*.class
*.jar
*.war
*.ear
out/
bin/
build/
target/
sources.txt

# ===============================================================
# Runtime Keystores & Cryptographic Materials
# (Auto-generated by KeystoreBootstrap on first server launch)
# ===============================================================
certs/*
!certs/.gitkeep

# ===============================================================
# Runtime Storage, Uploads & Databases
# (Auto-created and populated during server execution)
# ===============================================================
shared_storage/*
!shared_storage/.gitkeep
data/
downloads/
downloads_test/
*.db.tmp
history_*.log

# ===============================================================
# IDE & Editor Configuration Files
# ===============================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project/
.classpath/
*.sublime-project
*.sublime-workspace

# ===============================================================
# Operating System & Temporary Files
# ===============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*~
*.log
